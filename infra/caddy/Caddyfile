# DEPLOX Caddyfile — reverse proxy with dynamic per-hostname routing.
#
# Public traffic enters on :8000 (plain HTTP; Cloudflare Tunnel terminates
# TLS at the edge, so Caddy only needs HTTP). Two layers:
#
#   1. The :8000 site block below is the default catch-all — anything that
#      doesn't match a more specific route falls through to the dashboard.
#
#   2. Per-app hostnames (e.g. myapp.deplox.site) are added at runtime by
#      the DEPLOX API via POST /id/deplox-domain-<id>. Caddy auto-reorders
#      routes so static host matchers win over the catch-all.

# Global options: admin API on :2019 (used by the API to register/unregister
# routes dynamically).
#
# Important: we bind to 0.0.0.0 (not localhost) so Docker Desktop's port
# mapping on WSL2 actually forwards the host's traffic through. Binding to
# `localhost` works for in-container tools but the host gets ECONNRESET.
#
# `auto_https off` disables Caddy's automatic HTTPS / ACME certificate
# issuance. Cloudflare Tunnel terminates TLS at the edge, so Caddy only
# needs to serve plain HTTP. Without this, every `*.deplox.site` request
# triggers a (doomed) Let's Encrypt ACME challenge and Caddy replies
# 400 "Client sent an HTTP request to an HTTPS server".
{
	admin 0.0.0.0:2019
	auto_https off
}

# DEPLOX dashboard catch-all — falls through to the dev dashboard.
# Note: from inside the Caddy container, the DEPLOX host's services are
# reachable via Docker Desktop's host.docker.internal alias (not localhost,
# which would resolve to the container's own loopback).
#
# This route has NO host matcher so it greedily matches every request on
# :8000. Per-hostname routes (event-checkin-ec.deplox.site → localhost:9002
# etc.) MUST be inserted BEFORE this catch-all in the routes array, not
# appended after — see registerAutoSubdomainRoute() in apps/api/src/services/caddy.ts.
#
# Security headers (CSP, HSTS, X-Frame, etc.) are set HERE rather than in
# the API so they apply to every response — including the static HTML
# served by Vite (which is the one path the API can't reach). The API also
# sets them as a defense-in-depth measure for direct-port-8080 access.
:8000 {
	reverse_proxy host.docker.internal:5173

	header {
		# HSTS: 2 years + subdomains + preload-eligible. Cloudflare Tunnel
		# already serves HSTS, but we set it here too for direct access.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		# Clickjacking defense. CSP frame-ancestors is the modern equivalent
		# but X-Frame-Options covers older browsers.
		X-Frame-Options "DENY"
		# Block MIME-sniffing.
		X-Content-Type-Options "nosniff"
		# Don't leak full URLs to third parties.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Opt out of FLoC + sensors.
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
		# Spectre-class defense.
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		# CSP — tight policy for the Vite-served SPA + JSON API. Inline
		# styles allowed because Vite injects them; tighten later.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://avatars.githubusercontent.com https://api.github.com; frame-ancestors 'none'; form-action 'self' https://github.com; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
		# Belt-and-suspenders: remove the Server header so we don't leak
		# Caddy version in case Cloudflare ever changes its forwarding.
		-Server
	}
}