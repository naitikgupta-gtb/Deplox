{
  "name": "deplox",
  "version": "0.2.0",
  "private": true,
  "description": "DEPLOX — Honest deployment platform for developers. Stage 1+2 (Baby DEPLOX + Public Beta).",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" run dev",
    "dev:api": "pnpm --filter @deplox/api run dev",
    "dev:web": "pnpm --filter @deplox/web run dev",
    "dev:worker": "pnpm --filter @deplox/worker run dev",
    "build": "pnpm -r --filter \"./packages/*\" run build && pnpm -r --filter \"./apps/*\" run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @deplox/api run db:generate",
    "db:migrate": "pnpm --filter @deplox/api run db:migrate",
    "db:studio": "pnpm --filter @deplox/api run db:studio",
    "compose:up": "docker compose -f infra/docker-compose.yml up -d",
    "compose:down": "docker compose -f infra/docker-compose.yml down",
    "clean": "pnpm -r exec rm -rf dist .turbo node_modules/.cache",
    "tunnel:public": "node scripts/tunnel-public.mjs",
    "tunnel:public-only": "node scripts/tunnel-public.mjs --tunnel-only"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "rimraf": "^6.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}